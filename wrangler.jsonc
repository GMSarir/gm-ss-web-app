{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "gm-ss-web-app",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "96436cc7-53c3-4297-a113-65f2d76e01b6","database_name": "web-app" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "a5f5be6a36e1485183323d46a28baf8f" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
